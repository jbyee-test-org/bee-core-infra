{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bee-module merged values (module.yaml + values-<env>)",
  "description": "helm 에 -f module.yaml -f values-<env>.yaml 로 병합 입력되는 문서의 계약. required 는 최소만 — 어휘 확장은 additive(GENESIS G 어휘 로드맵).",
  "type": "object",
  "required": [
    "metadata",
    "spec",
    "env",
    "registry",
    "host",
    "namespace"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "image",
        "chart"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "chart": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "모듈의 chart 버전 pin (G6 — 모듈 pin 일원화). 불일치는 CLI 경고 + CI lint."
        },
        "product": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "port"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "auth": {
                "type": "string"
              },
              "rateLimit": {
                "type": "object"
              }
            }
          }
        },
        "events": {
          "type": "object",
          "description": "이벤트 어휘(0.2.0, G12②) — {stream, subject} 명시 객체. publishes=스트림 소유, consumes=durable Consumer.",
          "properties": {
            "publishes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "subject"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "consumes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "subject"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "property"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "property": {
                "type": "string"
              }
            }
          }
        },
        "db": {
          "type": "object",
          "description": "db 어휘(0.3.0, G14) — name=(kind,name) 공유 그룹(B안), migrations=SQL 디렉토리, grants=cross-schema 명시 선언.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "migrations": {
              "type": "string"
            },
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "schema"
                ],
                "properties": {
                  "schema": {
                    "type": "string"
                  },
                  "access": {
                    "type": "string",
                    "enum": [
                      "read"
                    ]
                  }
                }
              }
            }
          },
          "required": [
            "name"
          ]
        }
      }
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "description": "배치 좌표 — bee up/publish 가 platform product→ns 룩업으로 주입(G12④). 모듈 파일에 쓰지 않는다."
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "registry": {
      "type": "string",
      "minLength": 1
    },
    "imageTag": {
      "type": "string"
    },
    "imageDigest": {
      "type": "string"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "ingressClass": {
      "type": "string"
    },
    "asmPrefix": {
      "type": "string"
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "dbHost": {
      "type": "string",
      "description": "DB 좌표 — spec.db 선언 시 필요"
    },
    "dbName": {
      "type": "string"
    },
    "dbUser": {
      "type": "string"
    },
    "dbPassword": {
      "type": "string",
      "description": "데모 — 실환경 ESO(D13)"
    }
  }
}
